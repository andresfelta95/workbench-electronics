{
  "name": "electronics",
  "version": "0.1.0",
  "description": "Workbench — a free, bilingual (EN/ES), interactive electronics course, from Ohm's law to PCB design.",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "content": "node tools/build-content.mjs",
    "start": "node tools/build-content.mjs && ng serve",
    "build": "node tools/build-content.mjs && ng build",
    "watch": "node tools/build-content.mjs && ng build --watch --configuration development",
    "test": "ng test"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.7",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "gray-matter": "^4",
    "marked": "^16",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
